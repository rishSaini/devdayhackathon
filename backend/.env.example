# Defaults run locally without model charges, SMS, or phone calls.
RIPPLE_LIVE_MODELS=false
RIPPLE_LIVE_TWILIO=false
RIPPLE_DEMO_APPROVAL=false

OPENAI_API_KEY=
RIPPLE_DECISIONS_MODEL=gpt-6-luna
# Pin an account-supported model before enabling live agent execution.
RIPPLE_AGENT_MODEL=
RIPPLE_DECISIONS_TIMEOUT_S=2
RIPPLE_DECISIONS_RETRIES=1
RIPPLE_AGENT_TIMEOUT_S=15
RIPPLE_TOOL_TIMEOUT_S=10
RIPPLE_CONFIDENCE_THRESHOLD=0.70
RIPPLE_SPASM_WINDOW_MS=400
RIPPLE_CANCEL_WINDOW_S=5
RIPPLE_APPROVAL_TIMEOUT_S=600
RIPPLE_INPUT_TIMEOUT_S=300
# Relative paths resolve from the server's working directory. One worker owns this database.
RIPPLE_DATABASE_PATH=app/data/ripple.sqlite3
# Leave both empty only for local demo mode. Live Twilio requires distinct API tokens.
RIPPLE_USER_TOKEN=
RIPPLE_CAREGIVER_TOKEN=
RIPPLE_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Use teammate-owned test numbers only. E.164 format is required for live mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
HOME_PHONE=
CAREGIVER_PHONE=
EMERGENCY_CONTACT=
PUBLIC_BASE_URL=

USER_DISPLAY_NAME=Alex
DEMO_FALLBACK_LAT=37.7749
DEMO_FALLBACK_LNG=-122.4194

# Keep SDK debug logs from containing model or tool payloads.
OPENAI_AGENTS_DONT_LOG_MODEL_DATA=1
OPENAI_AGENTS_DONT_LOG_TOOL_DATA=1
